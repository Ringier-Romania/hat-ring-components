---
import {Author_getData} from "../../../../helpers/AuthorsHelper";
const {widgetConfig, context} = Astro.props;
import {WidgetHelper_getWidgetCssClasses} from "../../../../helpers/WidgetHelper";
import styles from "../../../../../styles/widgets/Story/StoryAuthors.module.scss";
import {default as StoryAuthor} from "../../Story/StoryAuthors/StoryAuthor.astro";



let response = widgetConfig?.response;
if (!response) {
    response = await Author_getData (context, widgetConfig);
}

let cssModules = styles.StoryAuthors;
---

<div class={WidgetHelper_getWidgetCssClasses('Author', widgetConfig, context, [cssModules])}>
    <StoryAuthor author={response.data.author} context={context} widgetConfig={widgetConfig}/>
</div>
