---
export interface Props {
    match: string;
    pageUrl: string;
    totalKeysText: string;
}

const { match, pageUrl, totalKeysText } = Astro.props;
const podName = process.env.HOSTNAME;
---

<div>
    <div>
        {podName} pod
    </div>
    <div> status:<span id="status">in progress...</span> | cursor: <span id="cursor"></span> | {totalKeysText}: <span id="totalKeys"></span>
        <br>
        <button id="toggle">Pause/Resume displaying results</button>
        <button id="stop">Stop the scan</button>
    </div>
    <div id="error"></div>
    <hr>
    <div style="display: table; white-space: pre-wrap; word-break:break-all; table-layout: fixed; width: 100%; max-height: 65vh; overflow-y: auto; overflow-x: auto; position: relative; content-visibility: auto; contain: layout paint; will-change: scroll; transform: translateZ(0); backface-visibility: hidden;"
         id="messages">
    </div>
</div>
<script define:vars={{ match, pageUrl }}>
    const statusEl = document.getElementById('status');
    const messagesEl = document.getElementById('messages');
    const cursorEl = document.getElementById('cursor');
    const totalKeysEl = document.getElementById('totalKeys');
    const errorEl = document.getElementById('error');
    let poller;
    let paused = false;

    function updateStatus(text) {
        if (statusEl) {
            statusEl.innerText = text;
        }
    }

    function handleData(data) {
        if (data.error) {
            if (errorEl) errorEl.innerHTML = `<pre>${data.error.stack}</pre>`;
            updateStatus('error');
            clearInterval(poller);
            return;
        }

        window.requestAnimationFrame(() => {
            if (cursorEl) {cursorEl.innerText = data.cursor;}
            if (totalKeysEl) {totalKeysEl.innerText = data.totalKeys;}
            if (statusEl) {statusEl.innerText = data.status;}

            if (['done', 'stopped'].includes(data.status)) {
                clearInterval(poller);
            }

            if (messagesEl && data.keys.length > 0) {
                const fragment = document.createDocumentFragment();
                const startIndex = messagesEl.children.length;
                data.keys.forEach((element, index) => {
                    const pre = document.createElement('pre');
                    pre.innerHTML = element.replaceAll('\\n', '<br>');
                    pre.style.cssText = 'padding: 5px; margin: 0;';
                    if ((startIndex + index) % 2 === 1) {
                        pre.style.backgroundColor = '#eaeaea';
                    }
                    fragment.appendChild(pre);
                });
                messagesEl.appendChild(fragment);
            }
        });
    }

    async function poll() {
        try {
            const response = await fetch(`/${pageUrl}?match=${match}&json=1`);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            const data = await response.json();
            handleData(data);
        } catch (e) {
            console.error('Polling error:', e);
            if (errorEl) errorEl.innerText = 'Polling error. See console for details.';
            clearInterval(poller);
        }
    }

    function startPolling() {
        if (!poller) {
            poll();
            poller = setInterval(poll, 1000);
        }
    }

    function stopPolling() {
        clearInterval(poller);
        poller = null;
    }

    document.querySelector('#toggle')?.addEventListener('click', () => {
        paused = !paused;
        const isRunning = statusEl && !['done', 'stopped', 'error'].includes(statusEl.innerText);
        if (isRunning) {
            updateStatus(paused ? 'in progress... (rendering paused)' : 'in progress...');
        }
        paused ? stopPolling() : startPolling();
    });

    document.querySelector('#stop')?.addEventListener('click', () => {
        updateStatus('stopped');
        fetch(`/${pageUrl}?stop=1&match=${match}`);
        stopPolling();
    });

    window.onbeforeunload = () => stopPolling();

    startPolling();
</script>
