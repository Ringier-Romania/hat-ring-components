---
import {SectionItemEdge} from "@ringpublishing/graphql-api-client/lib/types/websites-api";
const {
    context,
    widgetConfig,
    response,
    extendableAttributes
} = Astro.props;


import React from 'react';
import {AppContext} from "../../../../../types/types";
import {BasicWidgetConfig, BasicWidgetExtendableAttributes, BasicWidgetResponse} from "../types";
import * as ItemParts from "../itemParts";
import _ from "lodash";
import {RingLink} from "../../../../common/RingLink/RingLink";
import {WidgetHelper_renderEmptyComponent} from "../../../../../helpers/WidgetHelper";
import {UtilsHelper_getValueIfExists} from "../../../../../helpers/UtilsHelper";

interface AdditionalComponent extends SectionItemEdge {
    AdditionalComponent: Function;
    config: {
        widgetType: string;
    };
}

let toRender: boolean | JSX.Element | string = false;

const elementsToRender = _.get(response, 'data.section.items.edges', _.get(response, 'data.sectionGroup.sections[0].items.edges', [])) as SectionItemEdge[];
if (_.get(elementsToRender, 'length', 0) === 0) {
    toRender = WidgetHelper_renderEmptyComponent('SectionElements');
}

const allItemParts = extendableAttributes ? (extendableAttributes.itemParts || ItemParts) : ItemParts;
const columnsCount = parseInt(widgetConfig.columns || '0');
const bigElementsCount = Number(widgetConfig.countBig);
const colNumber = Math.floor(12 / columnsCount);
const bigElementsClass = bigElementsCount > 0 ? `bigElements${bigElementsCount}` : '';
const columnsClass = columnsCount > 0 ? `columns${columnsCount}` : '';
const additionalComponents = widgetConfig.additionalComponents;
const isMobile = context?.hatControllerParams?.isMobile;

if (additionalComponents && additionalComponents.length > 0) {
    additionalComponents.forEach((component: { widget: string; config: string }, index: number) => {    
        const widgetName = _.upperFirst(component?.widget?.trim());
        const AdditionalComponent = context?.customData?.widgets[widgetName];
        const { platformMobile: mobile, platformDesktop: desktop, pattern } = widgetConfig?.additionalComponents[index] || {};
        if (AdditionalComponent && pattern && ((isMobile && mobile) || (!isMobile && desktop))) {
            const [multiplier = 1, integerOffset = 0]: number[] = pattern.replace(/ /g, "").split("n")?.map(Number);
            try {
                const config = component?.config ? JSON.parse(component?.config) : "";
                for (let i = 1; i <= elementsToRender.length; i++) {
                    if (i >= integerOffset && (i - integerOffset) % multiplier === 0) {
                        elementsToRender.splice(i - 1, 0, { AdditionalComponent, config } as AdditionalComponent);
                    }
                }
            } catch (error) {
                console.error("Error parsing data", error);
            }
        }
    });
}
---

{
    toRender ? (
        <Fragment set:html={toRender} />
    ) : (
        <div class={['SectionElements', bigElementsClass, columnsClass].join(' ')}>
            {elementsToRender.map((edge, itemIndex) => {
                if (widgetConfig.count && itemIndex >= widgetConfig.count) {
                    return null;
                }
                const { AdditionalComponent, config } = edge as AdditionalComponent;
                if (AdditionalComponent && config) {
                    widgetConfig.count++;
                }
                const isBig = itemIndex < bigElementsCount;
                const colClass = isBig ? `col12` : `col${colNumber}`;
                const bigElementClass = isBig ? `bigElement` : '';
                return AdditionalComponent && config ? (
                    <div
                        key={itemIndex}
                        class={["AdditionalComponent", "Item", colClass, bigElementClass, config?.widgetType].join(" ")}
                    >
                        <AdditionalComponent widgetConfig={config} context={context} />
                    </div>
                ) : (
                    <div class={['Item', colClass, bigElementClass].join(' ')} key={itemIndex}>
                        <div class={'linkOverlay'}>
                            <RingLink href={edge.node?.externalUrl || edge.node?.url || '#'} title={edge.node?.title || ''}>
                                {widgetConfig.linkLabel}
                            </RingLink>
                        </div>
                        {widgetConfig.showOptions && widgetConfig.showOptions.map((showOption, index) => {
                                const Component = allItemParts[_.upperFirst(showOption)];

                                if (!Component) {
                                    console.error(`No item part support ${showOption}`);
                                return <Fragment set:html={WidgetHelper_renderEmptyComponent(_.upperFirst(showOption), "item part not supported, yet")}/>
                                }

                                return (
                                    <Component key={'aa' + itemIndex + index} itemIndex={itemIndex} context={context}
                                        widgetConfig={widgetConfig}
                                               data={edge.node}/>)
                            })}
                    </div>
                );
            })}
        </div>
    )
}
