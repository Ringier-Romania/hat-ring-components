---
const {context, widgetConfig} = Astro.props;

import {gql} from 'graphql-tag';
import {WebsiteApiProvider} from "../../../../providers/WebsiteApiProvider";
import {StoryDateResponse} from "./types";
import {DateHelper_convertDate} from "../../../../helpers/DateHelper";
import {WidgetHelper_getWidgetCssClasses} from "../../../../helpers/WidgetHelper";
const query = gql`
        query($storyId: UUID){
            story(id:$storyId){
                date {
                    modificationTime
                    creationTime
                }
                publication {
                    currentPublicationTime
                }
            }
        }
    `;
const variables = {
    storyId: context.id,
};
const dateFormat = widgetConfig.dateFormat;
const response = await WebsiteApiProvider.call(query, variables, widgetConfig?.cacheTTL) as StoryDateResponse;
let date: string | undefined;
switch (widgetConfig.dateType) {
    case 'lastPublicationDate':
        date = response.data.story.publication.currentPublicationTime
            || response.data.story.date.modificationTime
            || response.data.story.date.creationTime;
        break;
    case 'modificationTime':
        date = response.data.story.date.modificationTime
            || response.data.story.date.creationTime;
        break;
    default:
        date = response.data.story.date.creationTime;
}
const displayDate = await DateHelper_convertDate(context, date, dateFormat);
---

<div class={WidgetHelper_getWidgetCssClasses('StoryDate', widgetConfig, context)}>
    <time datetime={date}>{displayDate}</time>
</div>


