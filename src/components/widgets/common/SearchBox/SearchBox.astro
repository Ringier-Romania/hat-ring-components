---
import React from "react";
import _ from "lodash";
import { WidgetHelper_getWidgetCssClasses } from "../../../../helpers/WidgetHelper";
import { AppContext } from "../../../../types/types";
import { SearchBoxWidgetConfig } from "./types";
const { context, widgetConfig } = Astro.props as {
  context: AppContext;
  widgetConfig: SearchBoxWidgetConfig;
};
const { searchURLPhrase, searchParamPhrase, placeholder, buttonText } =
  widgetConfig;
---

<div
  class={WidgetHelper_getWidgetCssClasses("SearchBox", widgetConfig, context)}
>
  <form method="get" action={searchURLPhrase}>
    <input
      type="search"
      name={searchParamPhrase}
      {...placeholder && { placeholder }}
      required
    />

    <button>{buttonText}</button>
  </form>
</div>
