---
const {widgetConfig, context} = Astro.props as {
    widgetConfig: AbstractWidgetConfig;
    context: AppContext;
};
import _ from "lodash";
import {WidgetHelper_getWidgetCssClasses, WidgetHelper_renderEmptyComponent} from "../../../../helpers/WidgetHelper";
import {AbstractWidgetConfig, AppContext} from "../../../../types/types";

let toRender: boolean | JSX.Element | string = false;
const breadcrumbs = _.get(context, "hatControllerParams.gqlResponse.data.site.data.node.breadcrumbs");
const title = _.last(breadcrumbs).name;

if (!title) {
    toRender = WidgetHelper_renderEmptyComponent("TopicTitle");
}
---

{
    toRender ? (
        <Fragment set:html={toRender} />
    ) : (
        <div class={WidgetHelper_getWidgetCssClasses("TopicTitle", widgetConfig, context)}>
            <h1>{title}</h1>
        </div>
    )
}
