---
import {StoryTitleWidgetConfig} from "./types";
import {AppContext} from "../../../../types/types";
const {context, widgetConfig} = Astro.props as {context: AppContext, widgetConfig: StoryTitleWidgetConfig};

import _ from 'lodash';
import {gql} from 'graphql-tag';
import {WebsiteApiProvider} from "../../../../providers/WebsiteApiProvider";
import {StoryTitleResponse} from "./types";
import {WidgetHelper_getWidgetCssClasses, WidgetHelper_renderEmptyComponent} from "../../../../helpers/WidgetHelper";
import {ConfigHelper_getDeveloperSettingsConfig} from "../../../../helpers/ConfigHelper";

let toRender: boolean | JSX.Element | string = false;

let title: string | null | undefined = null;

const {displayTitleCodeName} = await ConfigHelper_getDeveloperSettingsConfig(context) || {displayTitleCodeName: ''};

const query = gql`
        query($storyId: UUID){
            story(id:$storyId){
                title
                titles {
                    role {
                        code
                    }
                    text
                }
            }
        }
    `;

const variables = {
    storyId: context.id,
};

let response = widgetConfig?.response;
if (!response) {
    response = await WebsiteApiProvider.call(query, variables, widgetConfig.cacheTTL) as StoryTitleResponse;
}

if (displayTitleCodeName && displayTitleCodeName !== '') {
    const displayTitleFound = response?.data?.story?.titles?.find((title) => title?.role?.code === displayTitleCodeName);
    title = displayTitleFound ? displayTitleFound.text : _.get(response, 'data.story.title');
} else {
    title = _.get(response, 'data.story.title');
}

if (!title) {
    toRender = WidgetHelper_renderEmptyComponent('Title','', true);
}
---
{toRender ?
    <Fragment set:html={toRender}/>
    :
    <div class={WidgetHelper_getWidgetCssClasses('StoryTitle', widgetConfig, context)}>
        <h1>{title}</h1>
    </div>
}
