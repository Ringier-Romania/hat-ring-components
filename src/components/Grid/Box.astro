---
const {context, boxName, widgets, size, tagName, sectionName} = Astro.props;

import React from "react";
import _ from "lodash";
import {AbstractWidgetConfig, AppContext} from "../../types/types";
import Widget from "./Widget.astro";
import styles from "../../../styles/Grid/Grid.module.scss";

//@TODO section config type
interface GridBoxParams {
    context: AppContext;
    boxName: string,
    widgets: Array<AbstractWidgetConfig>,
    size: number,
    tagName: string,
    sectionName: string
};
const BoxTag = `${tagName || 'div'}`;


---

<BoxTag className={['gridBox', boxName, 'gridCol' + size, styles.box].join(' ')}>
    {widgets && widgets.map((widgetConfig, i) => {
        return <>
            {Widget && <Widget widgetConfig={widgetConfig} context={context} key={i} index={i} boxName={boxName} sectionName={sectionName} />}
            </>
    })}
</BoxTag>
