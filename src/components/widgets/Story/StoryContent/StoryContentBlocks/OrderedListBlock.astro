---
const { blockData }: OrderedListBlockParams =
  Astro.props as OrderedListBlockParams;
import React from "react";
import { WidgetHelper_renderEmptyComponent } from "../../../../../helpers/WidgetHelper";

export interface OrderedListBlockParams {
  blockData: {
    type: string;
    entries: string[];
    indentLevel: number;
    styleType: string;
    startValue: number;
  };
}
let toRender: boolean | JSX.Element = false;
if (!blockData) {
  toRender = WidgetHelper_renderEmptyComponent("OrderedListBlock");
}
---

{
  toRender ? (
    <Fragment set:html={toRender} />
  ) : (
    <div className="OrderedListBlock">
      <ol>
        {blockData.entries.map((entry, index) => (
          <li key={index} set:html={entry} />
        ))}
      </ol>
    </div>
  )
}
