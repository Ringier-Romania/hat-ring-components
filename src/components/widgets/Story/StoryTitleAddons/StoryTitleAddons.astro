---
const {context, widgetConfig} = Astro.props as {context: AppContext; widgetConfig: StoryTitleAddonsWidgetConfig}
import _ from "lodash"
import {gql} from "graphql-tag"
import {AppContext} from "../../../../types/types"
import {StoryTitleAddonsWidgetConfig} from "./types"
import {StoryTitleAddonsResponse} from "./types"
import {WebsiteApiProvider} from "../../../../providers/WebsiteApiProvider"
import {WidgetHelper_getWidgetCssClasses, WidgetHelper_renderEmptyComponent} from "../../../../helpers/WidgetHelper"

let toRender: boolean | JSX.Element | string = false
const titleAddonsCodeNamesArr = _.without((widgetConfig.titleAddonsCodeNames ?? "").split(","), "")

const query = gql`
    query ($storyId: UUID) {
        story(id: $storyId) {
            titles {
                role {
                    code
                }
                text
            }
        }
    }
`

const variables = {
    storyId: context.id,
}

let response = widgetConfig?.response
if (!titleAddonsCodeNamesArr || titleAddonsCodeNamesArr.length === 0) {
    toRender = WidgetHelper_renderEmptyComponent("StoryTitleAddons")
} else {
    response = (await WebsiteApiProvider.call(query, variables)) as StoryTitleAddonsResponse
}
---

{
    toRender ? (
        <Fragment set:html={toRender} />
    ) : (
        titleAddonsCodeNamesArr?.map((codeName: string) => {
            const storyTitleAddonsToShow = _.get(
                _.find(response?.data?.story?.titles, ["role.code", codeName]),
                "text",
                ""
            )
            return (
                <div class={WidgetHelper_getWidgetCssClasses("StoryTitleAddons", widgetConfig, context)}>
                    <span class={`titleAddons code-${codeName}`}>{storyTitleAddonsToShow}</span>
                </div>
            )
        })
    )
}
