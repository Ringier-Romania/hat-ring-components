---
let html = await Astro.slots.render('default');
try {
    const allowedTags = ['meta', 'link', 'style', 'script'].join('|');
    const regex = new RegExp(`<\\/?(?!${allowedTags})\\w+[^>]*>`, 'gi');
    html = html.replace(regex, '');
} catch (e) {
    console.error(`SafeHead:`,e);
}
---

<!-- SAFE HEAD START -->
<Fragment set:html={html} />
<!-- SAFE HEAD END -->