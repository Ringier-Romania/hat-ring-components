---
import {WidgetHelper_shouldHideWidget} from "../../helpers/WidgetHelper";
const {context, boxName, widgets, size, tagName, sectionName} = Astro.props;

import React from "react";
import _ from "lodash";
import {AbstractWidgetConfig, AppContext} from "../../types/types";
import Widget from "./Widget.astro";
import styles from "../../../styles/Grid/Grid.module.scss";

//@TODO section config type
interface GridBoxParams {
    context: AppContext;
    boxName: string,
    widgets: Array<AbstractWidgetConfig>,
    size: number,
    tagName: string,
    sectionName: string
};
const BoxTag = `${tagName || 'div'}`;
let filteredWidgets = widgets;
const wrapperStartCount = widgets?.filter(widget => widget.widgetType === 'wrapperStart' && _.get(widget, 'enabled', true) && !WidgetHelper_shouldHideWidget(widget, context)).length;
const wrapperEndCount = widgets?.filter(widget => widget.widgetType === 'wrapperEnd' && _.get(widget, 'enabled', true) && !WidgetHelper_shouldHideWidget(widget, context)).length;

if (wrapperStartCount !== wrapperEndCount) {
    filteredWidgets = widgets?.filter(widget => widget.widgetType !== 'wrapperStart' && widget.widgetType !== 'wrapperEnd');
}

---

<BoxTag class={['gridBox', boxName, 'gridCol' + size, styles.box].join(' ')}>
    {filteredWidgets && filteredWidgets.map((widgetConfig, i) => {
        return <>
            {Widget && _.get(widgetConfig, 'enabled', true) && <Widget widgetConfig={widgetConfig} context={context} key={i} index={i} boxName={boxName} sectionName={sectionName} />}
            </>
    })}
</BoxTag>
