---
const {context, boxes, sectionName, sectionConfig} = Astro.props;

import React from "react";
import _ from "lodash";
import {AppContext} from "../../types/types";
import Box from "./Box.astro";

import styles from "../../../styles/Grid/Grid.module.scss";

//@TODO section config type
interface GridContainerParams {
    sectionName: string;
    sectionConfig: any;
    boxes: Array<string>,
    context: AppContext;

};
let toRender: boolean | JSX.Element = false;
if(!sectionConfig){
    toRender = null;
}
const ContainerTag = sectionConfig ? `${sectionConfig.container_html_tag || 'main'}` : 'main';
---


{toRender === null ?
    <Fragment set:html={toRender}/> :
    <ContainerTag class={['gridContainer', sectionName, sectionConfig.container_classes, styles.gridContainer].join(' ')}>
        {boxes.map((boxName, i) => {
            return !!sectionConfig[boxName + '_hide'] ? null :
                    <Box
                            context={context}
                            boxName={boxName}
                            widgets={sectionConfig[boxName]}
                            size={sectionConfig[boxName + '_size'] || 12}
                            tagName={sectionConfig[boxName + '_html_tag']}
                            key={i}
                            sectionName={sectionName}
                    />
        })}
    </ContainerTag>
    }
