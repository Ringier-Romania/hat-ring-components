---
const { context, blockData }: TableBlockParams = Astro.props as TableBlockParams;
import { WidgetHelper_renderEmptyComponent } from "@hatRingHelpers/WidgetHelper";
import {LinkReplacerHelper_replaceLinks} from '@hatRingHelpers/LinkReplacerHelper';
import { AppContext } from "@hatTypes/types";

export interface TableBlockParams {
  context: AppContext;
  blockData: {
    type: string;
    rows: [
      {
        cells: [
          {
            alignment: string;
            classes: string[];
            colspan: null | number;
            rowspan: null | number;
            isHeader: boolean;
            text: string;
            link: {
              url: string;
            };
          },
        ];
      },
    ] | [];
  };
}
let toRender: boolean | JSX.Element = false;
if (!blockData) {
  toRender = WidgetHelper_renderEmptyComponent("TableBlock");
}

blockData.rows = await Promise.all(blockData.rows.map(async (row) => {
  return Promise.all(row.cells.map(async (cell) => {
    cell.text = await LinkReplacerHelper_replaceLinks(context, cell.text);
    return cell;
  }));
}));

const { rows } = blockData;
---

{
  toRender ? (
    <Fragment set:html={toRender} />
  ) : (
    <table class="TableBlock">
      <tbody>
        {rows.map((row) => (
          <tr>
            {row.cells.map((cell) => {
              let allCellClasses = cell.alignment
                ? `align${cell.alignment} `
                : "";
              cell.classes.forEach(
                (cellClass) => allCellClasses + `${cellClass} `
              );

              return cell.isHeader ? (
                <th class={allCellClasses}>
                  {cell.link ? (
                    <a href={cell.link.url}>{cell.text}</a>
                  ) : (
                    cell.text
                  )}
                </th>
              ) : (
                <td
                  colSpan={cell.colspan ? cell.colspan : undefined}
                  rowSpan={cell.rowspan ? cell.rowspan : undefined}
                  className={allCellClasses}
                >
                  {cell.link ? (
                    <a href={cell.link.url}>{cell.text}</a>
                  ) : (
                    cell.text
                  )}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  )
}
