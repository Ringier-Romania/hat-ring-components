---
const {context, widgetConfig, extendableAttributes} = Astro.props;
import {default as StoryContentSwitcher} from "hat-ring-components/src/components/widgets/Story/StoryContent/StoryContentSwitcher.astro";
import {WidgetHelper_getWidgetCssClasses} from "hat-ring-components/src/helpers/WidgetHelper";
import {StoryContent_getData} from "./StoryContentGetData";
import _ from 'lodash';
import styles from "hat-ring-components/styles/widgets/Story/StoryContent.module.scss";

const response = await StoryContent_getData(context, widgetConfig);
const content = _.get(response, 'data.story.content[0].blocks');
const flags = _.get(response, 'data.story.flags', []).map((flag: any) => `flag_${flag.code}`);
---


<div class={WidgetHelper_getWidgetCssClasses('StoryContent', widgetConfig, context, [...flags, styles.StoryContent])}>
    <StoryContentSwitcher content={content} widgetConfig={widgetConfig} context={context}
                          extendableAttributes={extendableAttributes}/>
</div>

