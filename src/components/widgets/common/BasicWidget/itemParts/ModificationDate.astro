---
const {context, widgetConfig, data} = Astro.props;

import {WidgetHelper_renderEmptyComponent} from "@hatRingHelpers/WidgetHelper";
import gql from "graphql-tag";
import {DateHelper_convertDate} from "@hatRingHelpers/DateHelper";

let toRender: boolean | JSX.Element | string = false;

const dateFromData = data.modificationTime || data.originalContent?.modificationTime;

if (!dateFromData) {
    toRender = WidgetHelper_renderEmptyComponent('ModificationDate');
}

const displayDate = await DateHelper_convertDate(context, dateFromData);


export const getFragment = () => {
    return {
        variables: {},
        query: gql`fragment ModificationDateFragment on SectionItem {
            modificationTime
            originalContent {
                ... on Story {
                    date {
                        modificationTime
                    }
                }
            }
        }`
    }
}
---
{toRender ? <Fragment set:html={toRender}/> :
    <div class={['ModificationDate'].join(' ')}>
        <time dateTime={dateFromData}>
            {displayDate}
        </time>
    </div>
}



