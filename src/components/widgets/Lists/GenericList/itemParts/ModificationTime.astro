---
const {context, widgetConfig, data} = Astro.props;
import React from 'react';
import {AppContext} from "../../../../../types/types";
import {GenericListResponseNode, GenericListWidgetConfig} from "../types";
import _ from "lodash";
import {WidgetHelper_renderEmptyComponent} from "../../../../../helpers/WidgetHelper";
import gql from "graphql-tag";
import {RingLink} from "../../../../common/RingLink/RingLink";
import {DateHelper_convertDate} from "../../../../../helpers/DateHelper";

let toRender: boolean | JSX.Element = false;
if (!data?.date?.creationTime) {
    toRender = WidgetHelper_renderEmptyComponent('ModificationTime');
}

const displayDate = await DateHelper_convertDate(context, data?.date?.modificationTime);


export const getFragment = () => {
    return {
        variables: {},
        query: gql`fragment ModificationTimeFragment on Story {
            date {
                modificationTime
            }
        }`
    }
}
---

{toRender ? <Fragment set:html={toRender}/> :
<div className={['ModificationTime'].join(' ')}>
    {displayDate}
</div>}





