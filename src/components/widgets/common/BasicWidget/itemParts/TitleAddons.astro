---
const {widgetConfig, data} = Astro.props
import {BasicWidgetConfig} from "../types"
import gql from "graphql-tag"
import _ from "lodash"
import { WidgetHelper_renderEmptyComponent } from "../../../../../helpers/WidgetHelper"

type Props = {
    widgetConfig: BasicWidgetConfig & {
        titleAddonsCodeNames: string
    }
    data: {
        originalContent: {
            titles: {
                role: {
                    code: string
                }
                text: string
            }[]
        }
    }
}
let toRender: boolean | JSX.Element | string = false;

const titleAddonsCodeNamesArr = _.without((widgetConfig.titleAddonsCodeNames ?? "").split(","), "")

if (!titleAddonsCodeNamesArr || titleAddonsCodeNamesArr.length === 0) {
    toRender = WidgetHelper_renderEmptyComponent("TitleAddons")
}
export const getFragment = () => {
    return {
        variables: {},
        query: gql`
            fragment TitleAddonsFragment on SectionItem {
                originalContent {
                    ... on Story {
                        titles {
                            role {
                                code
                            }
                            text
                        }
                    }
                }
            }
        `,
    }
}
---

{
    toRender ? (
        <Fragment set:html={toRender} />
    ) : (
        <div class="TitleAddons">
            {titleAddonsCodeNamesArr.map((codeName: string) => {
                const titleAddonsToShow = _.get(_.find(data.originalContent.titles, ["role.code", codeName]), "text", "");                
                return !!titleAddonsToShow ? (
                    <span class={`title-addons code-${codeName}`}>{titleAddonsToShow}</span>
                ) : null;
            })}
        </div>
    )
}