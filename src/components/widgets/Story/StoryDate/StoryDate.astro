---
const {context, widgetConfig} = Astro.props;
import _ from "lodash"
import {gql} from 'graphql-tag';
import {WebsiteApiProvider} from "hat-ring-components/src/providers/WebsiteApiProvider";
import {StoryDateResponse} from "hat-ring-components/src/components/widgets/Story/StoryDate/types";
import {DateHelper_convertDate} from "hat-ring-components/src/helpers/DateHelper";
import {
    WidgetHelper_getWidgetCssClasses,
    WidgetHelper_renderEmptyWidget
} from "hat-ring-components/src/helpers/WidgetHelper";
import {StoryPrefetch_getResponse} from "../../../../helpers/StoryPrefetchHelper";

const query = gql`
        query($storyId: UUID){
            story(id:$storyId){
                date {
                    modificationTime
                    creationTime
                }
                publication {
                    currentPublicationTime
                }
            }
        }
    `;
const variables = {
    storyId: context.id,
};
const dateFormat = widgetConfig.dateFormat;

// Prioritate: 1) prefetch din context, 2) query individual
const response = (StoryPrefetch_getResponse(context) ?? await WebsiteApiProvider.call(query, variables, widgetConfig?.cacheTTL)) as StoryDateResponse;

let date: string | null | undefined;
let toRender: boolean | React.JSX.Element | string = false;
let displayDate = '';
switch (widgetConfig.dateType) {
    case 'lastPublicationDate':
        date = _.get(response, 'data.story.publication.currentPublicationTime')
            || _.get(response, 'data.story.date.modificationTime')
            || _.get(response, 'data.story.date.creationTime')
        break;
    case 'modificationTime':
        date = _.get(response, 'data.story.date.modificationTime')
            || _.get(response, 'data.story.date.creationTime')
        break;
    default:
        date = _.get(response, 'data.story.date.creationTime')
}
if (!date) {
    toRender = WidgetHelper_renderEmptyWidget(widgetConfig);
} else {
    displayDate = await DateHelper_convertDate(context, date, dateFormat);
}
---
{toRender ?
    <Fragment set:html={toRender}/> :
    <div class={WidgetHelper_getWidgetCssClasses('StoryDate', widgetConfig, context)}>
        <time datetime={date}>{displayDate}</time>
    </div>
}

