---
const { context, blockData }: HeadingBlockParams = Astro.props as HeadingBlockParams;
import { WidgetHelper_renderEmptyComponent } from "@hatRingHelpers/WidgetHelper";
import {LinkReplacerHelper_replaceLinks} from '@hatRingHelpers/LinkReplacerHelper';
import { AppContext } from "@hatTypes/types";

export interface HeadingBlockParams {
  context: AppContext;
  blockData: {
    type: string;
    text: string;
    level: number;
  };
}
let toRender: boolean | JSX.Element = false;

if (!blockData) {
  toRender = WidgetHelper_renderEmptyComponent("HeadingBlock");
}
const HeadingTag = "h" + blockData.level;

blockData.text = await LinkReplacerHelper_replaceLinks(context, blockData.text);
---

{
  toRender ? (
    <Fragment set:html={toRender} />
  ) : (
    <div class="HeadingBlock">
      <HeadingTag set:html={blockData.text} />
    </div>
  )
}
