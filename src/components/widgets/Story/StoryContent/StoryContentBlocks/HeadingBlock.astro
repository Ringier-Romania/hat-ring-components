---
const { blockData }: HeadingBlockParams = Astro.props as HeadingBlockParams;
import React from "react";
import { WidgetHelper_renderEmptyComponent } from "../../../../../helpers/WidgetHelper";

export interface HeadingBlockParams {
  blockData: {
    type: string;
    text: string;
    level: number;
  };
}
let toRender: boolean | JSX.Element = false;

if (!blockData) {
  toRender = WidgetHelper_renderEmptyComponent("HeadingBlock");
}
const HeadingTag = "h" + blockData.level;
---

{
  toRender ? (
    <Fragment set:html={toRender} />
  ) : (
    <div className="HeadingBlock">
      <HeadingTag set:html={blockData.text} />
    </div>
  )
}
