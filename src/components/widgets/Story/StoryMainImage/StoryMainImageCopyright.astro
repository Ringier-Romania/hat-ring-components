---
const {response} = Astro.props;

const copyrightNote = response?.data?.story?.image?.image?.license?.note;
const sources = response?.data?.story?.image?.image?.sources
---

{copyrightNote && <p class="StoryMainImageCopyright">{copyrightNote}</p>}

{!copyrightNote && sources && sources.length > 0 && <p class="StoryMainImageCopyright">
    {sources.map((source: any) => {
        return source.source?.link?.url ?
                <a class="source" href={source.source?.link?.url}>{source.source?.name}</a> :
                <span class="source">{source.source?.name}</span>
    })}</p>}

