---
const { blockData }: ParagraphBlockParams = Astro.props as ParagraphBlockParams;
import React from "react";
import { WidgetHelper_renderEmptyComponent } from "../../../../../helpers/WidgetHelper";

export interface ParagraphBlockParams {
  blockData: {
    type: string;
    text: string;
  };
}
let toRender: boolean | JSX.Element = false;
if (!blockData) {
  toRender = WidgetHelper_renderEmptyComponent("ParagraphBlock");
}
---

{
  toRender ? (
    <Fragment set:html={toRender} />
  ) : (
    <div className="ParagraphBlock">
      <p set:html={blockData.text} />
    </div>
  )
}
