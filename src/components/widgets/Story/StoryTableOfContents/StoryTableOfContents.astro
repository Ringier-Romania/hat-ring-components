---
import { AppContext } from "../../../../types/types";
import { AbstractWidgetConfig } from "../../../../types/types";
import {
    WidgetHelper_getWidgetCssClasses,
    WidgetHelper_renderEmptyWidget,
    WidgetHelper_shouldHideWidget,
} from "../../../../helpers/WidgetHelper";

const { context, widgetConfig } = Astro.props as {
    context: AppContext;
    widgetConfig: AbstractWidgetConfig & {
        contentSelector: string;
        headingSelector: string;
        title: string;
    };
};

let toRender: boolean | string | JSX.Element = false;

if (WidgetHelper_shouldHideWidget(widgetConfig, context)) {
    toRender = WidgetHelper_renderEmptyWidget(widgetConfig);
}

const tocTitle = widgetConfig?.title || "Contents";
const contentSelector = widgetConfig?.contentSelector || ".StoryContent";
const headingSelector = widgetConfig?.headingSelector || "h2";
---

{toRender ? (
    <Fragment set:html={toRender} />
) : (
    <section class={WidgetHelper_getWidgetCssClasses("StoryTableOfContents", widgetConfig, context)}>
        <h3 class="TocTitle">{tocTitle}</h3>
        <nav role="navigation">
            <ol class="TocList" data-content-selector={contentSelector} data-heading-selector={headingSelector}></ol>
        </nav>
    </section>
)}

<script is:inline>
(function () {
    // Mirrors UtilsHelper_slugify from src/helpers/UtilsHelper.ts
    function slugify(text) {
        return text
            .normalize('NFKD')
            .replace(/[\u0300-\u036f]/g, '')
            .trim()
            .toLowerCase()
            .replace(/[^a-z0-9 -]/g, '')
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-');
    }

    function initToc(tocEl) {
        if (tocEl.dataset.initialized) return;
        tocEl.dataset.initialized = 'true';

        var list = tocEl.querySelector('.TocList');
        if (!list) return;

        var contentSelector = list.dataset.contentSelector;
        var headingSelector = list.dataset.headingSelector || 'h2';
        var container = document.querySelector(contentSelector);
        if (!container) return;

        var headings = Array.from(container.querySelectorAll(headingSelector));
        if (!headings.length) {
            tocEl.style.display = 'none';
            return;
        }

        headings.forEach(function (h, i) {
            if (!h.id) {
                var slug = slugify(h.textContent || '');
                h.id = slug || ('section-' + i);
            }
            var li = document.createElement('li');
            li.className = 'TocItem';
            var a = document.createElement('a');
            a.className = 'TocLink';
            a.href = '#' + h.id;
            a.textContent = h.textContent;
            li.appendChild(a);
            list.appendChild(li);
        });

        tocEl.classList.add('js-ready');

        var items = Array.from(list.querySelectorAll('.TocItem'));

        // Set first item as active on page load
        if (items.length > 0) {
            items[0].classList.add('active');
        }

        items.forEach(function (item) {
            item.querySelector('a').addEventListener('click', function (e) {
                e.preventDefault();
                var targetId = this.getAttribute('href').slice(1);
                var target = document.getElementById(targetId);
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        if (!('IntersectionObserver' in window)) return;

        var activeItem = items.length > 0 ? items[0] : null;

        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    if (activeItem) activeItem.classList.remove('active');
                    activeItem = items.find(function (it) {
                        return it.querySelector('a').getAttribute('href') === '#' + entry.target.id;
                    }) || null;
                    if (activeItem) activeItem.classList.add('active');
                }
            });
        }, {
            rootMargin: '-10% 0px -80% 0px',
            threshold: 0
        });

        headings.forEach(function (h) { observer.observe(h); });
    }

    function initAll() {
        document.querySelectorAll('.StoryTableOfContents').forEach(function (toc) {
            initToc(toc);
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
    } else {
        initAll();
    }
})();
</script>

