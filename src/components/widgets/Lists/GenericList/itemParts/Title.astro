---
import {AppContext} from "../../../../../types/types";
import {GenericListResponseNode, GenericListWidgetConfig} from "../types";
import _ from "lodash";
import {WidgetHelper_renderEmptyComponent} from "../../../../../helpers/WidgetHelper";
import {ConfigHelper_getDeveloperSettingsConfig} from "../../../../../helpers/ConfigHelper";
import gql from "graphql-tag";

type Props = {
    context: AppContext,
    widgetConfig: GenericListWidgetConfig,
    data: GenericListResponseNode,
}

const {context, widgetConfig, data} = Astro.props as Props;

const {displayTitleCodeName} = await ConfigHelper_getDeveloperSettingsConfig(context) || '';

const title = data?.titles?.find((title) => title?.role?.code === displayTitleCodeName)?.text || data.title;

if (!title) {
    return WidgetHelper_renderEmptyComponent('Title','',true);
}

const HeaderTag = (widgetConfig.headerTag && widgetConfig.headerTag !== 'none' ? widgetConfig.headerTag : 'span' ) as keyof JSX.IntrinsicElements;
let ItemHeaderTag = HeaderTag;

const itemsHeaderArr = HeaderTag.split('h');
if (itemsHeaderArr.length === 2) {
    const tagLevel = Number(itemsHeaderArr[1]);
    if (tagLevel >= 6) {
        ItemHeaderTag = 'span';
    } else {
        ItemHeaderTag = `h${_.clamp(tagLevel + 1, 2, 6)}` as keyof JSX.IntrinsicElements;
    }
}

export const getFragment = () => {
    return {
        variables: {},
        query: gql`fragment TitleFragment on Story {
            title
            titles {
                role {
                    code
                }
                text
            }
        }`
    }
}
---
<div class={['Title'].join(' ')}>
    <ItemHeaderTag>{title}</ItemHeaderTag>
</div>



