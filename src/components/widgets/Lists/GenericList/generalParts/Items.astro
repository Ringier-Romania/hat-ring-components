---
import {AdditionalComponentHelper_insertComponentAtPattern} from "../../../../../helpers/AdditionalComponentHelper";
const {
    context,
    widgetConfig,
    response,
    extendableAttributes
}: {
    context: AppContext,
    widgetConfig: GenericListWidgetConfig,
    response: GenericListResponse
    extendableAttributes: any
} = Astro.props;

import {AppContext} from "../../../../../types/types";
import {WidgetHelper_renderEmptyComponent} from "../../../../../helpers/WidgetHelper";
import {GenericListResponse, GenericListWidgetConfig} from "../types";
import * as ItemParts from "./../itemParts";
import _ from "lodash";
import {RingLink} from "../../../../common/RingLink/RingLink";
import {UtilsHelper_convertToInt} from "../../../../../helpers/UtilsHelper";
import AdditionalComponentTemplate from "../../../../common/AdditionalComponentTemplate.astro";
const allItemParts = (extendableAttributes ? extendableAttributes.itemParts : null) || ItemParts;
const columnsCount = UtilsHelper_convertToInt(widgetConfig.columns) || 1;
const colNumber = Math.floor(12 / columnsCount);
const columnsClass = columnsCount > 0 ? `columns${columnsCount}` : '';
const elementsToRender = _.get(response, 'data.stories.edges', []);

const processedContent = AdditionalComponentHelper_insertComponentAtPattern(elementsToRender, widgetConfig, context);
---
<div class={['Items', columnsClass].join(' ')}>
    {(processedContent.map((edge, itemIndex) => {
        const colClass = `col${colNumber}`;
        function itemRenderer() {
            const itemParts = widgetConfig.showOptions && widgetConfig.showOptions.map((showOption, index) => {
                const Component = allItemParts[_.upperFirst(showOption)];
                if (!Component) {
                    console.error(`No item part support ${showOption}`);
                    return WidgetHelper_renderEmptyComponent(_.upperFirst(showOption), "item part not supported, yet");
                }

                return  <Component key={index} itemIndex={itemIndex} context={context} widgetConfig={widgetConfig}
                                   data={edge.node}/>;
            });

            return (<div class={['Item', colClass, `kind-${edge.node?.kind?.code}`].join(' ')}>
                <div class={'linkOverlay'}>
                    <RingLink href={edge.node?.mainPublicationPoint?.url || '#'} title={edge.node?.title}>
                        {widgetConfig.linkLabel}
                    </RingLink>
                </div>
                {itemParts}
            </div>)
        }

        return <AdditionalComponentTemplate edge={edge} classNames={[colClass, 'Item']} defaultRender={itemRenderer} context={context}/>
    }))}
</div>
