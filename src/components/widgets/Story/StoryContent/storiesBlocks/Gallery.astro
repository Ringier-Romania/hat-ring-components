---
import Slider from "../../../common/Slider/Slider.astro";
const { blockData, context, widgetConfig } = Astro.props;
import { gql } from "graphql-tag";
import _ from "lodash";
import { ImageBlock, EmbedBlock } from "@ringpublishing/graphql-api-client/lib/types/websites-api";
import { ImageSourceReference } from "@ringpublishing/graphql-api-client/lib/types/websites-api";
import { WebsiteApiProvider } from "../../../../../providers/WebsiteApiProvider";
import { UtilsHelper_convertToInt, UtilsHelper_isMobile } from "../../../../../helpers/UtilsHelper";
import { EmbeddedApplicationBlock } from "../StoryContentBlocks";

let toRender: boolean | string | null = false;

const galleryUuid = _.get(blockData, "stories.0.story.id", null);
const embeddedBlockTypeName = "EmbedBlock";
const imageBlockTypeName = "ImageBlock";
if (!galleryUuid) {
    toRender = null;
}

const variables = {
    storyID: galleryUuid,
};

const query = gql`
    query ($storyID: UUID) {
        story(id: $storyID) {
            id
            title
            galleryContent: content(role: "gallery") {
                blocks {
                    ... on ImageBlock {
                        title
                        url
                        image {
                            description
                            width
                            height
                            sources {
                                source {
                                    name
                                }
                            }
                        }
                    }
                    ... on EmbedBlock {
                        type
                        embed {
                            id
                            html
                            kind {
                                code
                            }
                        }
                    }
                }
            }
        }
    }
`;

const result = await WebsiteApiProvider.call(query, variables);

const filteredBlocks: (ImageBlock | EmbedBlock)[] = _.get(result, "data.story.galleryContent.0.blocks", []).filter(
    (block: ImageBlock | EmbedBlock) =>
        block.__typename === embeddedBlockTypeName || block.__typename === imageBlockTypeName
);

const slides = filteredBlocks.map((block) => {
    if (block.__typename === embeddedBlockTypeName) {
        return {
            type: "embedded_application",
            embed: _.get(block, "embed", ''),
        };
    } else if (block.__typename === imageBlockTypeName) {
        const imageBlock = block as ImageBlock;
        let imageWidth = _.get(imageBlock, "image.width", 1920);
        let imageHeight = _.get(imageBlock, "image.height", 1920);

        let maxImageWidth =
            widgetConfig.standardImageWidth && UtilsHelper_convertToInt(widgetConfig.standardImageWidth);
        let maxImageHeight =
            widgetConfig.standardImageHeight && UtilsHelper_convertToInt(widgetConfig.standardImageHeight);

        if (UtilsHelper_isMobile(context)) {
            maxImageWidth = widgetConfig.mobileImageWidth && UtilsHelper_convertToInt(widgetConfig.mobileImageWidth);
            maxImageHeight = widgetConfig.mobileImageHeight && UtilsHelper_convertToInt(widgetConfig.mobileImageHeight);
        }

        if (maxImageWidth && maxImageWidth < imageWidth) {
            imageHeight = Math.floor(UtilsHelper_convertToInt((maxImageWidth * imageHeight) / imageWidth));
            imageWidth = maxImageWidth;
        }

        if (maxImageHeight && maxImageHeight < imageHeight) {
            imageWidth = Math.floor(UtilsHelper_convertToInt((maxImageHeight * imageWidth) / imageHeight));
            imageHeight = maxImageHeight;
        }

        return {
            text: "",
            children: [],
            "Source type": "Image",
            "Source url": _.get(imageBlock, "url", null),
            "Source desktop dimensions(eg. 600x300)": imageWidth + "x" + imageHeight,
            Title: _.get(imageBlock, "title", null),
            Description: _.get(imageBlock, "image.sources", [])
                .map((contentSource: ImageSourceReference) => contentSource.source.name)
                .join(","),
            "Link url": "",
            isExpanded: true,
            originalImageDimensions: {
                width: _.get(imageBlock, "image.width", null),
                height: _.get(imageBlock, "image.height", null),
            },
        };
    }
    return "";
});
const sliderWidgetConfig = {
    module: "slider_wdg",
    platformDesktop: true,
    platformMobile: true,
    customClass: "",
    customPosition: "none",
    customWidth: "none",
    widgetType: "slider",
    slides: slides || [],
    slidesPerView: 1,
    autoplayDelay: 0,
    loop: false,
    navigation: true,
    pagination: false,
    breakpoints: [
        {
            text: "",
            children: [],
            "Slides per view": "1",
            "Minimal screen size": "1024",
        },
    ],
    headerSeoTag: "none",
    headerText: _.get(result, "data.story.title", ""),
    navigationButtonsOutside: false,
    isUsedWithLightbox: true,
};
---

{
    toRender === null ? (
        <Fragment set:html={toRender} />
    ) : (
        <div class="Gallery">
            {slides.length > 0 && <Slider widgetConfig={sliderWidgetConfig} context={context} />}
        </div>
    )
}
