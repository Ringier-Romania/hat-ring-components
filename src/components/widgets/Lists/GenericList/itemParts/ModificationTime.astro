---
import {WidgetHelper_renderEmptyComponent} from "@hatRingHelpers/WidgetHelper";
import gql from "graphql-tag";
import {DateHelper_convertDate} from "@hatRingHelpers/DateHelper";
import {AppContext} from "@hatTypes/types";
import { GenericListResponseNode, GenericListWidgetConfig } from "../types";


type Props = {
    context: AppContext,
    widgetConfig: GenericListWidgetConfig,
    data: GenericListResponseNode,
}
const {context, widgetConfig, data} = Astro.props;

let toRender: boolean | string | JSX.Element = false;
if (!data?.date?.modificationTime) {
    toRender = WidgetHelper_renderEmptyComponent('ModificationTime');
}

const displayDate = await DateHelper_convertDate(context, data?.date?.modificationTime);

export const getFragment = () => {
    return {
        variables: {},
        query: gql`fragment ModificationTimeFragment on Story {
            date {
                modificationTime
            }
        }`
    }
}
---

{toRender ? <Fragment set:html={toRender}/> :
<div class={['ModificationTime'].join(' ')}>
    {displayDate}
</div>}
