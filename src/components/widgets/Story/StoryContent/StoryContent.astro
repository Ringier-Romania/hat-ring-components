---
const {context, widgetConfig, extendableAttributes} = Astro.props;
import {default as StoryContentSwitcher} from "./StoryContentSwitcher.astro";
import {WidgetHelper_getWidgetCssClasses} from "../../../../helpers/WidgetHelper";
import {StoryContent_getData} from "./StoryContentGetData";


const content = await StoryContent_getData(context);
---


<div class={WidgetHelper_getWidgetCssClasses('StoryContent', widgetConfig, context)}>
    {/* @ts-expect-error Server Component */}
    <StoryContentSwitcher content={content} widgetConfig={widgetConfig} context={context}
                          extendableAttributes={extendableAttributes}/>
</div>
