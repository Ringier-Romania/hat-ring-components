---
import { BasicWidget_getData } from "./BasicWidgetGetData";
const { context, widgetConfig, extendableAttributes } = Astro.props;
import { BasicWidgetAdditionalOptions, BasicWidgetResponse } from "./types";
import * as GeneralParts from "./generalParts";
import _ from "lodash";
import styles from "../../../../../styles/widgets/common/BasicWidget.module.scss";
import {
    WidgetHelper_getWidgetCssClasses,
    WidgetHelper_renderEmptyWidget,
    WidgetHelper_shouldHideWidget,
} from "../../../../helpers/WidgetHelper";
import { intersection } from "astro:schema";
let toRender: boolean | JSX.Element | string = false;

if (!widgetConfig) {
    toRender = WidgetHelper_renderEmptyWidget(widgetConfig);
}
if (WidgetHelper_shouldHideWidget(widgetConfig, context)) {
    toRender = WidgetHelper_renderEmptyWidget(widgetConfig);
}
const allGeneralParts = (extendableAttributes ? extendableAttributes.generalParts : null) || GeneralParts;
let response: BasicWidgetResponse;
if (!toRender) {
    let queryFragment = "";

    response =
        widgetConfig.section_name !== ""
            ? ((await BasicWidget_getData(context, queryFragment, widgetConfig, extendableAttributes)) as BasicWidgetResponse)
            : ({} as BasicWidgetResponse);

    let edges = _.get(response, "data.section.items.edges", []);
    let groupSectionEdges = _.get(response, "data.sectionGroup.sections[0].items.edges", []);
    let offset = Number(widgetConfig.offset);

    if (edges.length > 0) {
        _.set(response, "data.section.items.edges", edges.slice(offset));
    } else if (response?.data?.sectionGroup?.sections && groupSectionEdges.length > 0) {
        _.set(response, "data.sectionGroup.sections[0].items.edges", groupSectionEdges.slice(offset));
    }

    const hideWhenNoItems =
        widgetConfig.additionalOptions &&
        widgetConfig.additionalOptions.includes(BasicWidgetAdditionalOptions.HideWhenNoSectionItems);
    if (hideWhenNoItems && edges.length === 0) {
        toRender = WidgetHelper_renderEmptyWidget(widgetConfig);
    }

    const additionalComponents = widgetConfig.additionalComponents;

    if (additionalComponents && additionalComponents.length > 0) {
        
        additionalComponents.forEach((component, index) => {
            const pattern = widgetConfig.additionalComponents[index].pattern;
            const patternParts = pattern.replace(/ /g,'').split('n');
            const multiplier = patternParts && patternParts[0] ? Number(patternParts[0]) : 1;
            const integerOffset = patternParts && patternParts[1] ? Number(patternParts[1]) : 0;
            const widgetName = _.upperFirst(component.widget.trim());
            const config = JSON.parse(component.config);
            const additionalComponent = context.customData.widgets[widgetName];
            for (let i = 1; i <= edges.length - widgetConfig.count; i++) {
                if (i >= integerOffset && (i - integerOffset) % multiplier === 0) {
                    edges.splice(i - 1, 0, { additionalComponent, config });
                    i++;
                }
            }
            _.set(response, "data.section.items.edges", edges);
        });
    }
}

let cssModules = styles.BasicWidget;
---

{
    toRender ? (
        <Fragment set:html={toRender} />
    ) : (
        <div class={WidgetHelper_getWidgetCssClasses("BasicWidget", widgetConfig, context, [cssModules])}>
            {widgetConfig.generalShowOptions &&
                widgetConfig.generalShowOptions.map((showOption, index) => {
                    const Component = allGeneralParts[_.upperFirst(showOption)];
                    if (!Component || !context) {
                        console.error(`No general show option name support ${showOption}`);
                        return;
                    }
                    return (
                        <Component
                            key={index}
                            context={context}
                            widgetConfig={widgetConfig}
                            response={response}
                            extendableAttributes={extendableAttributes}
                        />
                    );
                })}
        </div>
    )
}
