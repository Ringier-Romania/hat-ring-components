---
const {context, widgetConfig} = Astro.props as {
    context: AppContext;
    widgetConfig: AbstractWidgetConfig & {frameCodeName: string; storyFrameHeadding: string};
};
import {AppContext} from "../../../../types/types";
import {AbstractWidgetConfig} from "../../../../types/types";
import {WidgetHelper_getWidgetCssClasses, WidgetHelper_renderEmptyWidget} from "../../../../helpers/WidgetHelper";
import {StoryContent_getData} from "../StoryContent/StoryContentGetData";
import StoryGroup from "../../../Story/StoryGroup.astro";
import _ from "lodash";

let toRender: boolean | string | JSX.Element = false;
const response = await StoryContent_getData(context, widgetConfig);
const contentBlocks = _.get(response, 'data.story.content[0].blocks');
const frameCodeName = widgetConfig.frameCodeName;
const storyFrameHeadding = widgetConfig.storyFrameHeadding;

if (!contentBlocks || !contentBlocks.find((block) => block.name === frameCodeName)) {
    toRender = WidgetHelper_renderEmptyWidget(widgetConfig);
}
---

{
    toRender ? (
        <Fragment set:html={toRender} />
    ) : (
        <div class={WidgetHelper_getWidgetCssClasses("StoryFrame", widgetConfig, context)}>
            {storyFrameHeadding && (
                <div class={`storyFrameHeadding`} data-frame-code-name={frameCodeName}>
                    {storyFrameHeadding}
                </div>
            )}
            <div class="storyFrameText">
                <StoryGroup context={context} contentBlocks={contentBlocks} groupName={frameCodeName} />
            </div>
        </div>
    )
}
