---
const {context, widgetConfig} = Astro.props as {context: AppContext; widgetConfig: StoryTitleAddonsWidgetConfig}
import _ from "lodash"
import {gql} from "graphql-tag"
import {AppContext} from "hat-ring-components/src/types/types"
import {StoryTitleAddonsWidgetConfig} from "hat-ring-components/src/components/widgets/Story/StoryTitleAddons/types"
import {StoryTitleAddonsResponse} from "hat-ring-components/src/components/widgets/Story/StoryTitleAddons/types"
import {WebsiteApiProvider} from "hat-ring-components/src/providers/WebsiteApiProvider"
import {WidgetHelper_getWidgetCssClasses, WidgetHelper_renderEmptyComponent} from "hat-ring-components/src/helpers/WidgetHelper"
import {StoryPrefetch_getResponse} from "../../../../helpers/StoryPrefetchHelper"

let toRender: boolean | React.JSX.Element | string = false
const titleAddonsCodeNamesArr = _.without((widgetConfig.titleAddonsCodeNames ?? "").split(","), "")

const query = gql`
    query ($storyId: UUID) {
        story(id: $storyId) {
            titles {
                role {
                    code
                }
                text
            }
        }
    }
`

const variables = {
    storyId: context.id,
}

let response: StoryTitleAddonsResponse | null = null;
if (!titleAddonsCodeNamesArr || titleAddonsCodeNamesArr.length === 0) {
    toRender = WidgetHelper_renderEmptyComponent("StoryTitleAddons")
} else {
    // Prioritate: 1) prefetch din context, 2) query individual
    response = (StoryPrefetch_getResponse(context) ?? await WebsiteApiProvider.call(query, variables, widgetConfig?.cacheTTL)) as StoryTitleAddonsResponse
}
---

{
    toRender ? (
        <Fragment set:html={toRender} />
    ) : (
        titleAddonsCodeNamesArr?.map((codeName: string) => {
            const storyTitleAddonsToShow = _.get(
                _.find(response?.data?.story?.titles, ["role.code", codeName]),
                "text",
                ""
            )
            return (
                <div class={WidgetHelper_getWidgetCssClasses("StoryTitleAddons", widgetConfig, context)}>
                    <span class={`title-addons code-${codeName}`}>{storyTitleAddonsToShow}</span>
                </div>
            )
        })
    )
}

