---
const {context, widgetConfig} = Astro.props;

import _ from "lodash";
import {gql} from 'graphql-tag';
import {WebsiteApiProvider} from "hat-ring-components/src/providers/WebsiteApiProvider";
import {StoryTaxonomyListResponse} from "hat-ring-components/src/components/widgets/Story/StoryTaxonomyList/types";
import RingLink from "hat-ring-components/src/components/common/RingLink.astro";
import {WidgetHelper_getWidgetCssClasses, WidgetHelper_renderEmptyWidget, WidgetHelper_shouldHideWidget} from "hat-ring-components/src/helpers/WidgetHelper";
import {default as TextReplacer} from "hat-ring-components/src/components/common/TextReplacer.astro";
import {StoryPrefetch_getResponse} from "../../../../helpers/StoryPrefetchHelper";

const query = gql`
        query($storyId: UUID){
            story(id:$storyId){
                topics{
                    topic {
                        id
                        nodeReference {
                            node {
                                breadcrumbs {
                                    url
                                }
                            }
                        }
                        kind {
                            code
                        }
                        name
                        publicationPoint {
                            url
                        }
                    }
                }
            }
        }
    `;
const variables = {
    storyId: context.id,
};

let toRender: boolean | React.JSX.Element | string = false;

if (WidgetHelper_shouldHideWidget(widgetConfig, context)) {
    toRender = WidgetHelper_renderEmptyWidget(widgetConfig);
}

// Prioritate: 1) prefetch din context, 2) query individual
const response = !toRender
    ? (StoryPrefetch_getResponse(context) ?? await WebsiteApiProvider.call(query, variables, widgetConfig?.cacheTTL) as StoryTaxonomyListResponse)
    : null;

const topics = response?.data?.story?.topics || [];
const taxonomyList = (widgetConfig?.taxonomyKind || '').split(',').map((kind: string) => kind.trim());
const excludedUuids = (widgetConfig?.excludedUuids || '').split(',').map((uuid: string) => uuid.trim());
const filteredTopics = topics.filter((topic: any) => {
    if (!taxonomyList.includes(topic.topic.kind.code) || excludedUuids.includes(topic.topic.id)) {
        return false;
    }
    return true;
});

const sortedTopics = _.sortBy(filteredTopics, topic => {
    return taxonomyList.indexOf(topic.topic.kind.code)
});

if (!toRender && sortedTopics.length === 0) {
    toRender = WidgetHelper_renderEmptyWidget(widgetConfig);
}
---
{toRender ?
    <Fragment set:html={toRender}/> :
    <div class={WidgetHelper_getWidgetCssClasses('StoryTaxonomyList', widgetConfig, context)}>
        {widgetConfig.listPrefix && <TextReplacer context={context} config={{}} text={widgetConfig.listPrefix} tag={"span"} props={{class: 'listPrefix'}}/>}

        {sortedTopics.map((topic: any) => {
            let breadcrumbUrl = topic.topic?.nodeReference?.node.breadcrumbs[topic.topic?.nodeReference?.node.breadcrumbs.length - 1];
            let url = (breadcrumbUrl ? breadcrumbUrl.url : null) || topic.topic?.publicationPoint?.url;
            return url && widgetConfig.links ?
                <RingLink context={context} href={url}>
                    <span class={`topic kind-${topic.topic.kind.code}`}>{topic.topic.name}</span>
                </RingLink> : <span class={`topic kind-${topic.topic.kind.code}`}>{topic.topic.name}</span>
            }
        )}
    </div>
}

