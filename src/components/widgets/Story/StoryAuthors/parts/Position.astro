---
import { StoryAuthorsWidgetConfig } from "../types";
const { context, widgetConfig, author } = Astro.props as {
    context: AppContext;
    widgetConfig: StoryAuthorsWidgetConfig;
    author: Author;
};
import { Author } from "@ringpublishing/graphql-api-client/lib/types/websites-api";
import _ from "lodash";
import { AppContext } from "../../../../../types/types";
import {
    WidgetHelper_getWidgetCssClasses,
    WidgetHelper_renderEmptyComponent,
} from "../../../../../helpers/WidgetHelper";
import { TranslationProvider } from "../../../../../providers/TranslationProvider";

let toRender: boolean | JSX.Element | string = false;

const position = _.get(author, "occupation.position", "");

if (!position || position.length === 0) {
    toRender = WidgetHelper_renderEmptyComponent("Position");
}
---

{
    toRender ? (
        <Fragment set:html={toRender} />
    ) : (
        <div class={["Position"].join(" ")}>
            <h2>{TranslationProvider.translate(context, "Position")}</h2>
            <div class="position">{position}</div>
        </div>
    )
}
