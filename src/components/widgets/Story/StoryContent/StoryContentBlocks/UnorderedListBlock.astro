---
const { context, blockData }: UnorderedListBlockParams =
  Astro.props as UnorderedListBlockParams;
import { WidgetHelper_renderEmptyComponent } from "@hatRingHelpers/WidgetHelper";
import {LinkReplacerHelper_replaceLinks} from '@hatRingHelpers/LinkReplacerHelper';
import { AppContext } from "@hatTypes/types";

export interface UnorderedListBlockParams {
  context: AppContext;
  blockData: {
    type: string;
    entries: string[];
    indentLevel: number;
    styleType: string;
  };
}
let toRender: boolean | JSX.Element = false;

if (!blockData) {
  toRender = WidgetHelper_renderEmptyComponent("UnorderedListBlock");
}

blockData.entries = await Promise.all(blockData.entries.map(async (entry) => {
  return LinkReplacerHelper_replaceLinks(context, entry);
}));
---

{
  toRender ? (
    <Fragment set:html={toRender} />
  ) : (
    <div class="UnorderedListBlock">
      <ul>
        {blockData.entries.map((entry, index) => (
          <li set:html={entry} />
        ))}
      </ul>
    </div>
  )
}
