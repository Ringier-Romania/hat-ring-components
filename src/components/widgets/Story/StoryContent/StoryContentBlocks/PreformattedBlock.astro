---
const { blockData }: PreformattedBlockParams =
  Astro.props as PreformattedBlockParams;

import React from "react";
import { WidgetHelper_renderEmptyComponent } from "../../../../../helpers/WidgetHelper";

export interface PreformattedBlockParams {
  blockData: {
    type: string;
    text: string;
  };
}
let toRender: boolean | JSX.Element = false;
if (!blockData) {
  toRender = WidgetHelper_renderEmptyComponent("PreformattedBlock");
}
---

{
  toRender ? (
    <Fragment set:html={toRender} />
  ) : (
    <div className="PreformattedBlock">
      <pre set:html={blockData.text} />
    </div>
  )
}
