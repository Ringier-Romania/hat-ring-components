---
import {WidgetHelper_getWidgetCssClasses} from "../../helpers/WidgetHelper";
import StoryContentSwitcher from "../widgets/Story/StoryContent/StoryContentSwitcher.astro";
import {StoryHelper_getGroupContent} from "../../helpers/StoryHelper";
const {context, groupName, contentBlocks} = Astro.props;

const blocks = StoryHelper_getGroupContent(contentBlocks, groupName);

---

<div class={WidgetHelper_getWidgetCssClasses('StoryGroup',{}, context, [groupName])  }>
    <StoryContentSwitcher content={blocks} widgetConfig={{}} context={context} extendableAttributes={{}}/>
</div>
